{
  "name": "codeswitch-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx src/cli/demo.ts",
    "test:browser": "playwright test",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "benchmark:baseline": "tsx src/evaluation/cli.ts baseline",
    "benchmark:llm": "tsx src/evaluation/cli.ts llm",
    "benchmark:report": "tsx src/evaluation/cli.ts report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-tc": "^5.3.1",
    "ajv": "^8.20.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
